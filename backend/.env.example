# Server Configuration
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/photo_gallery

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_photo_gallery_2026_secure!
JWT_EXPIRE=30d

# Cloudinary Integration (leave as dummy for local fallback or provide your real Cloudinary keys)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Frontend Client URL
CLIENT_URL=http://localhost:5173
